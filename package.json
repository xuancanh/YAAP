{
  "name": "yaam-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/dist/main.js",
    "server:build": "rm -rf server/dist && tsc -p server/tsconfig.json",
    "server:dev": "tsx watch server/src/main.ts",
    "build": "npm run server:build && tsc -b && vite build",
    "lint": "eslint .",
    "packs:build": "node scripts/build-authored-packs.mjs",
    "knowledge:build": "node scripts/build-knowledge.mjs",
    "knowledge:check": "node scripts/build-knowledge.mjs --check",
    "blueprints:build": "TSX_TSCONFIG_PATH=tests/tsconfig.json tsx scripts/derive-starter-tunables.ts && node scripts/build-builtin-companies.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "test": "TSX_TSCONFIG_PATH=tests/tsconfig.json tsx --test --test-concurrency=${TEST_CONCURRENCY:-3} tests/*.test.ts",
    "test:web": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "codemirror": "6.0.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "markdown-it": "14.1.0",
    "pg": "^8.21.0",
    "prosemirror-markdown": "1.13.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.6",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.52.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  }
}
