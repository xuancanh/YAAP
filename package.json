{
  "name": "yaam-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/dist/main.js",
    "server:build": "rm -rf server/dist && tsc -p server/tsconfig.json",
    "server:dev": "tsx watch server/src/main.ts",
    "build": "npm run server:build && tsc -b && vite build",
    "lint": "eslint .",
    "test": "TSX_TSCONFIG_PATH=tests/tsconfig.json tsx --test tests/backend-chats.test.ts tests/backend-schema.test.ts tests/backend-storage-keys.test.ts tests/backend-anthropic.test.ts tests/backend-tools.test.ts tests/backend-turn-loop.test.ts tests/backend-compaction.test.ts tests/backend-skills.test.ts tests/backend-search.test.ts tests/backend-openai.test.ts tests/backend-loops.test.ts tests/backend-mcp.test.ts tests/backend-telegram.test.ts tests/backend-market.test.ts tests/backend-appbridge.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.6",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.3"
  },
  "license": "AGPL-3.0-or-later"
}
