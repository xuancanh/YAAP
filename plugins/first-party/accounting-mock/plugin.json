{
  "manifestVersion": 1,
  "id": "accounting-mock@yaam",
  "name": "Mock books (mock provider)",
  "description": "A deterministic provider of accounting@1 served by the core's fixture stub: no network, no code, no secrets. It makes the accounting (interface) work out of the box for trying the kit and its dashboard cards; connect a real provider when one ships.",
  "license": "AGPL-3.0-or-later",
  "version": "1.0.0",
  "publisher": {
    "id": "yaam",
    "name": "yaam",
    "verifiedDomain": "yaam.chat"
  },
  "roles": [
    "provider"
  ],
  "requires": {
    "yaamCore": "^1.0",
    "interfaces": [
      "accounting@^1"
    ]
  },
  "provides": [
    {
      "interface": "accounting@^1",
      "resources": [
        "accounting://mock.example"
      ],
      "operations": {
        "cash_summary": {
          "fixture": "fixtures/accounting.json"
        },
        "list_invoices": {
          "fixture": "fixtures/accounting.json"
        },
        "list_expenses": {
          "fixture": "fixtures/accounting.json"
        },
        "send_invoice": {
          "fixture": "fixtures/accounting.json"
        }
      },
      "conformance": {
        "mode": "mock"
      }
    }
  ],
  "budgets": {
    "callsPerMinute": 120,
    "concurrent": 4,
    "maxCostPerCallUsd": 0.01
  }
}
