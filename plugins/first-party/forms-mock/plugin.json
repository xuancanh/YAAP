{
  "manifestVersion": 1,
  "id": "forms-mock@yaam",
  "name": "Mock forms (mock provider)",
  "description": "A deterministic provider of forms@1 served by the core's fixture stub: no network, no code, no secrets. It makes the forms and surveys (interface) work out of the box for trying the kit and its dashboard cards; connect a real provider when one ships.",
  "license": "AGPL-3.0-or-later",
  "version": "1.0.0",
  "publisher": {
    "id": "yaam",
    "name": "yaam",
    "verifiedDomain": "yaam.chat"
  },
  "roles": [
    "provider"
  ],
  "requires": {
    "yaamCore": "^1.0",
    "interfaces": [
      "forms@^1"
    ]
  },
  "provides": [
    {
      "interface": "forms@^1",
      "resources": [
        "forms://mock.example"
      ],
      "operations": {
        "list_responses": {
          "fixture": "fixtures/forms.json"
        },
        "read_response": {
          "fixture": "fixtures/forms.json"
        }
      },
      "conformance": {
        "mode": "mock"
      }
    }
  ],
  "budgets": {
    "callsPerMinute": 120,
    "concurrent": 4,
    "maxCostPerCallUsd": 0.01
  }
}
