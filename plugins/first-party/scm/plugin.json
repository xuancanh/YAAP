{
  "manifestVersion": 1,
  "id": "scm@yaam",
  "name": "Source control (interface)",
  "description": "The scm@1 contract: hosted git repositories with branches and pull requests that are reviewed and merged. Declares operations, classes, the pull_request change kind, events and metrics. No code, no egress.",
  "license": "AGPL-3.0-or-later",
  "version": "1.0.0",
  "publisher": { "id": "yaam", "name": "yaam", "verifiedDomain": "yaam.chat" },
  "roles": ["interface"],
  "requires": { "yaamCore": "^1.0" },
  "interfaces": [{
    "name": "scm",
    "version": "1.0.0",
    "semantics": "Hosted git repositories with branches and pull requests that are reviewed and merged.",
    "resources": { "scheme": "scm", "pattern": "scm://{host}/{owner}/{repo}",
                   "schema": { "type": "string", "pattern": "^scm://[a-z0-9.-]+/[^/]+/[^/]+$" } },
    "uses": ["ci@^1"],
    "defs": {
      "prSummary": { "type": "object", "required": ["number", "title", "headSha", "base"],
                     "properties": { "number": { "type": "integer" }, "title": { "type": "string" }, "headSha": { "type": "string" },
                                     "base": { "type": "string" }, "url": { "type": "string" } } },
      "pr": { "type": "object", "required": ["number", "title", "headSha", "base", "state"],
              "properties": { "number": { "type": "integer" }, "title": { "type": "string" }, "body": { "type": "string" },
                              "headSha": { "type": "string" }, "base": { "type": "string" }, "head": { "type": "string" },
                              "state": { "enum": ["open", "closed", "merged"] }, "reviewState": { "type": "string" }, "url": { "type": "string" } } }
    },
    "operations": {
      "list_prs": { "required": true, "semantics": "Open or recent pull requests in a repository.",
                    "input": { "type": "object", "required": ["repo"], "additionalProperties": false,
                               "properties": { "repo": { "$ref": "#resource" }, "state": { "enum": ["open", "closed", "all"] } } },
                    "output": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/defs/prSummary" } } } },
                    "class": "read", "reversibility": "none", "outbound": false, "idempotent": true, "untrustedOutput": true,
                    "cost": { "unit": "call", "usd": 0.0002 } },
      "read_pr": { "required": true, "semantics": "One pull request with its description, head SHA, base and review state.",
                   "input": { "type": "object", "required": ["repo", "number"], "additionalProperties": false,
                              "properties": { "repo": { "$ref": "#resource" }, "number": { "type": "integer" } } },
                   "output": { "$ref": "#/defs/pr" },
                   "class": "read", "reversibility": "none", "outbound": false, "idempotent": true, "untrustedOutput": true,
                   "cost": { "unit": "call", "usd": 0.0002 } },
      "read_diff": { "required": true, "semantics": "The diff of a pull request.",
                     "input": { "type": "object", "required": ["repo", "number"], "additionalProperties": false,
                                "properties": { "repo": { "$ref": "#resource" }, "number": { "type": "integer" } } },
                     "output": { "type": "object", "required": ["diff"], "properties": { "diff": { "type": "string" } } },
                     "class": "read", "reversibility": "none", "outbound": false, "idempotent": true, "untrustedOutput": true,
                     "cost": { "unit": "call", "usd": 0.0002 } },
      "create_branch": { "required": true, "semantics": "A branch from a ref.",
                         "input": { "type": "object", "required": ["repo", "name", "from"], "additionalProperties": false,
                                    "properties": { "repo": { "$ref": "#resource" }, "name": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,200}$" }, "from": { "type": "string" } } },
                         "output": { "type": "object", "required": ["name", "sha"], "properties": { "name": { "type": "string" }, "sha": { "type": "string" } } },
                         "class": "external_reversible", "reversibility": "reversible", "outbound": false, "idempotent": true, "untrustedOutput": false,
                         "cost": { "unit": "call", "usd": 0.0005 } },
      "push": { "required": true, "semantics": "Push commits prepared in an execution environment to a non-default branch.",
                "input": { "type": "object", "required": ["repo", "branch"], "additionalProperties": false,
                           "properties": { "repo": { "$ref": "#resource" }, "branch": { "type": "string" }, "workdir": { "type": "string" } } },
                "output": { "type": "object", "required": ["branch", "sha"], "properties": { "branch": { "type": "string" }, "sha": { "type": "string" } } },
                "class": "external_reversible", "reversibility": "reversible", "outbound": true, "idempotent": true, "untrustedOutput": false,
                "classByInput": [ { "path": "$.branch", "in": ["main", "master", "trunk"], "class": "external_irreversible" } ],
                "cost": { "unit": "call", "usd": 0.0005 } },
      "open_pr": { "required": true, "semantics": "Open a pull request; creates a pull_request change record.",
                   "input": { "type": "object", "required": ["repo", "head", "base", "title"], "additionalProperties": false,
                              "properties": { "repo": { "$ref": "#resource" }, "head": { "type": "string" }, "base": { "type": "string" },
                                              "title": { "type": "string", "maxLength": 300 }, "body": { "type": "string", "maxLength": 20000 } } },
                   "output": { "type": "object", "required": ["number", "headSha", "base", "state"],
                               "properties": { "number": { "type": "integer" }, "headSha": { "type": "string" }, "base": { "type": "string" },
                                               "state": { "type": "string" }, "url": { "type": "string" } } },
                   "class": "external_reversible", "reversibility": "reversible", "outbound": true, "idempotent": true, "untrustedOutput": false,
                   "change": { "kind": "pull_request", "role": "propose" },
                   "cost": { "unit": "call", "usd": 0.0005 } },
      "comment": { "required": true, "semantics": "Comment on a pull request.",
                   "input": { "type": "object", "required": ["repo", "number", "body"], "additionalProperties": false,
                              "properties": { "repo": { "$ref": "#resource" }, "number": { "type": "integer" }, "body": { "type": "string", "maxLength": 20000 } } },
                   "output": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } },
                   "class": "external_reversible", "reversibility": "reversible", "outbound": true, "idempotent": false, "untrustedOutput": false,
                   "cost": { "unit": "call", "usd": 0.0005 } },
      "review": { "required": true, "semantics": "Approve or request changes on a pull request.",
                  "input": { "type": "object", "required": ["repo", "number", "event"], "additionalProperties": false,
                             "properties": { "repo": { "$ref": "#resource" }, "number": { "type": "integer" },
                                             "event": { "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT"] }, "body": { "type": "string", "maxLength": 20000 } } },
                  "output": { "type": "object", "required": ["state"], "properties": { "state": { "type": "string" } } },
                  "class": "external_reversible", "reversibility": "reversible", "outbound": true, "idempotent": true, "untrustedOutput": false,
                  "change": { "kind": "pull_request", "role": "review", "verdict": { "path": "$.event", "approveIn": ["APPROVE"] } },
                  "cost": { "unit": "call", "usd": 0.0005 } },
      "merge": { "required": true, "semantics": "Merge an approved pull request at the reviewed head SHA.",
                 "input": { "type": "object", "required": ["repo", "number", "headSha"], "additionalProperties": false,
                            "properties": { "repo": { "$ref": "#resource" }, "number": { "type": "integer" }, "headSha": { "type": "string" } } },
                 "output": { "type": "object", "required": ["mergeSha"], "properties": { "mergeSha": { "type": "string" } } },
                 "class": "external_irreversible", "reversibility": "irreversible", "outbound": false, "idempotent": true, "untrustedOutput": false,
                 "change": { "kind": "pull_request", "role": "apply" },
                 "cost": { "unit": "call", "usd": 0.001 } },
      "revert": { "required": true, "semantics": "Revert a merged pull request with a new commit on the base.",
                  "input": { "type": "object", "required": ["repo", "number"], "additionalProperties": false,
                             "properties": { "repo": { "$ref": "#resource" }, "number": { "type": "integer" } } },
                  "output": { "type": "object", "required": ["revertSha"], "properties": { "revertSha": { "type": "string" } } },
                  "class": "external_irreversible", "reversibility": "costly", "outbound": false, "idempotent": true, "untrustedOutput": false,
                  "change": { "kind": "pull_request", "role": "rollback" },
                  "cost": { "unit": "call", "usd": 0.001 } }
    },
    "changeKinds": {
      "pull_request": {
        "semantics": "Code proposed on a branch and merged into a base.",
        "reversibility": "costly",
        "bind": { "repo": { "$ref": "#resource" }, "number": { "type": "integer" }, "headSha": { "type": "string" }, "base": { "type": "string" } },
        "verify": [ { "event": "ci.run.completed", "match": "$.sha == {{applied.mergeSha}} && $.conclusion == 'success'", "within": "45m" } ],
        "requirement": "two_key"
      }
    },
    "events": {
      "pr.opened": { "semantics": "A pull request was opened.", "payload": { "$ref": "#/defs/prSummary" }, "correlates": "pr" },
      "pr.updated": { "semantics": "New commits or a changed description.", "payload": { "$ref": "#/defs/prSummary" }, "correlates": "pr" },
      "pr.merged": { "semantics": "A pull request was merged.", "payload": { "$ref": "#/defs/prSummary" }, "correlates": "pr" },
      "pr.closed": { "semantics": "Closed without merging.", "payload": { "$ref": "#/defs/prSummary" }, "correlates": "pr" },
      "review.submitted": { "semantics": "A review was submitted.", "payload": { "type": "object" }, "correlates": "pr" },
      "push": { "semantics": "Commits were pushed.", "payload": { "type": "object", "properties": { "sha": { "type": "string" }, "branch": { "type": "string" } } } }
    },
    "metrics": {
      "lead_time_for_changes": { "kind": "duration_between", "of": "scm.pr.opened", "and": "scm.pr.merged", "correlateBy": "pr", "window": "7d", "unit": "hours" },
      "merge_frequency": { "kind": "rate", "of": "scm.pr.merged", "window": "7d", "unit": "per day" }
    },
    "conformance": "conformance/scm/suite.json"
  }]
}
