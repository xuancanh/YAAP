{
  "manifestVersion": 1,
  "id": "observability-mock@yaam",
  "name": "Mock monitoring (mock provider)",
  "description": "A deterministic provider of observability@1 served by the core's fixture stub: no network, no code, no secrets. It makes the observability (interface) work out of the box for trying the kit and its dashboard cards; connect a real provider when one ships.",
  "license": "AGPL-3.0-or-later",
  "version": "1.0.0",
  "publisher": {
    "id": "yaam",
    "name": "yaam",
    "verifiedDomain": "yaam.chat"
  },
  "roles": [
    "provider"
  ],
  "requires": {
    "yaamCore": "^1.0",
    "interfaces": [
      "observability@^1"
    ]
  },
  "provides": [
    {
      "interface": "observability@^1",
      "resources": [
        "observability://mock.example"
      ],
      "operations": {
        "list_incidents": {
          "fixture": "fixtures/observability.json"
        },
        "read_incident": {
          "fixture": "fixtures/observability.json"
        },
        "acknowledge": {
          "fixture": "fixtures/observability.json"
        },
        "resolve": {
          "fixture": "fixtures/observability.json"
        }
      },
      "conformance": {
        "mode": "mock"
      }
    }
  ],
  "budgets": {
    "callsPerMinute": 120,
    "concurrent": 4,
    "maxCostPerCallUsd": 0.01
  }
}
