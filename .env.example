# API server port (Vite dev proxy targets this; keep in sync with vite.config.ts)
PORT=8790

# Postgres (docker-compose.dev.yml defaults)
DATABASE_URL=postgres://yaamchat:yaamchat@localhost:5433/yaamchat

# S3-compatible object storage for workspace files (MinIO in dev)
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=yaam-chat
S3_ACCESS_KEY_ID=yaamchat
S3_SECRET_ACCESS_KEY=yaamchat-secret
S3_FORCE_PATH_STYLE=true

# Per-chat defaults
DEFAULT_TOKEN_CEILING=200000
MAX_TOOL_ROUNDS=24
COMPACTION_THRESHOLD_TOKENS=120000
# Per-round LLM stream timeout (ms) — guards against stalled provider connections
PROVIDER_TIMEOUT_MS=300000
# Scheduled agent loops (FR-11.6)
LOOPS_ENABLED=true

# External service connections (docs/integrations.md). BYO Google OAuth client:
# register <PUBLIC_BASE_URL>/api/connections/google/callback as a redirect URI.
# PUBLIC_BASE_URL=http://localhost:8790
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Seals connection tokens at rest (any string; required for hosted deployments).
# TOKEN_ENCRYPTION_KEY=

# Microsoft Graph connections (docs/integrations.md step 6). Register
# <PUBLIC_BASE_URL>/api/connections/microsoft/callback in the Entra app.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=

# Code runner (docs/code-execution.md §5): where run_js / run_python execute.
# auto (default) = cloudflare when RUNNER_CF_* are set, else the local OS
# sandbox (macOS sandbox-exec / Linux bubblewrap), else the tools are absent.
# RUNNER_BACKEND=auto
# Paid tier: deploy cloudflare/runner-worker, then point at it. The token must
# match the worker's RUNNER_TOKEN secret.
# RUNNER_CF_URL=https://yaam-runner.<subdomain>.workers.dev
# RUNNER_CF_TOKEN=

# Telegram bot channel (phase 4). Empty = channel disabled. Inbox events for
# the paired default agent are pushed to the chat with a link back to the app.
# TELEGRAM_BOT_TOKEN=
# PUBLIC_APP_URL=http://localhost:5175

# Vulnerability-disclosure address published by GET /api/security and
# docs/security.md. Empty = the policy is shown without a contact.
# SECURITY_CONTACT=security@your-domain.example

# Voice notes (docs/voice.md): audio attachments transcribe on upload through
# an OpenAI-compatible POST {base}/audio/transcriptions; the same base serves
# optional reply TTS (/audio/speech, Settings → Chat). off = both disabled.
# Without TRANSCRIPTION_API_KEY the stored key of the OpenAI agent type is used.
# TRANSCRIPTION_PROVIDER=openai-compatible
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# TRANSCRIPTION_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts

# Dev escape hatch: let outbound server-side fetches (web_fetch/http_request
# tools, agent custom tools, MCP server URLs) reach private/internal addresses.
# Never set this in a hosted deployment — it disables the SSRF guard.
# YAAM_ALLOW_PRIVATE_URLS=true

# --- Cloudflare R2 (hosted: staging/prod, see docs/environments.md) ---
# R2 speaks S3 via aws-sdk v3 with a per-account endpoint. Use one bucket per
# environment (e.g. yaam-chat-staging / yaam-chat-prod) and an R2 API token
# scoped to that bucket. Region must be "auto" and path style off (R2 uses
# virtual-hosted style).
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=yaam-chat-prod
# S3_ACCESS_KEY_ID=<r2-api-token-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-api-token-secret-access-key>
# S3_FORCE_PATH_STYLE=false
